#include <iostream>
#include <stack>
#include <string>
using namespace std;

int main() {
    stack<int> s;
    string postfix;

    cout << "Enter postfix expression: ";
    cin >> postfix;

    for (int i = 0; i < postfix.length(); i++) {
        char ch = postfix[i];

        if (ch >= '0' && ch <= '9') {
            s.push(ch - '0');
        }
        else {
            int b = s.top();
            s.pop();

            int a = s.top();
            s.pop();

            if (ch == '+')
                s.push(a + b);
            else if (ch == '-')
                s.push(a - b);
            else if (ch == '*')
                s.push(a * b);
            else if (ch == '/')
                s.push(a / b);
        }
    }

    cout << "Result: " << s.top();
    return 0;
}
