#include <iostream>
using namespace std;

int main()
{
    int n;

    cout << "Enter number of students: ";
    cin >> n;

    int marks[100];

    cout << "Enter marks of students:\n";

    for (int i = 0; i < n; i++)
    {
        cout << "Student " << i + 1 << ": ";
        cin >> marks[i];
    }

    int total = 0;
    int highest = marks[0];
    int lowest = marks[0];

    for (int i = 0; i < n; i++)
    {
        total += marks[i];

        if (marks[i] > highest)
            highest = marks[i];

        if (marks[i] < lowest)
            lowest = marks[i];
    }

    double average = (double)total / n;

    cout << "\nStudent Mark Analysis\n";
    cout << "Total Marks: " << total << endl;
    cout << "Average Marks: " << average << endl;
    cout << "Highest Marks: " << highest << endl;
    cout << "Lowest Marks: " << lowest << endl;

    cout << "\nStudents scoring above average:\n";

    for (int i = 0; i < n; i++)
    {
        if (marks[i] > average)
        {
            cout << "Student " << i + 1
                 << ": " << marks[i] << endl;
        }
    }

    return 0;
}
