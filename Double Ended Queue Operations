#include <iostream>
#include <queue>
using namespace std;

priority_queue<int> pq;

void insertFront()
{
    int x;
    cout << "Enter element: ";
    cin >> x;
    pq.push(x);
    cout << "Element inserted at front.\n";
}

void insertRear()
{
    int x;
    cout << "Enter element: ";
    cin >> x;
    pq.push(x);
    cout << "Element inserted at rear.\n";
}

void deleteFront()
{
    if (pq.empty())
        cout << "Queue is empty.\n";
    else
    {
        cout << "Deleted element: " << pq.top() << endl;
        pq.pop();
    }
}

void deleteRear()
{
    if (pq.empty())
        cout << "Queue is empty.\n";
    else
    {
        cout << "Deleted element: " << pq.top() << endl;
        pq.pop();
    }
}

void display()
{
    if (pq.empty())
    {
        cout << "Queue is empty.\n";
        return;
    }

    priority_queue<int> temp = pq;

    cout << "Elements: ";

    while (!temp.empty())
    {
        cout << temp.top() << " ";
        temp.pop();
    }

    cout << endl;
}

void getSize()
{
    cout << "Number of elements: " << pq.size() << endl;
}

int main()
{
    int choice;

    do
    {
        cout << "\n--- DOUBLE ENDED QUEUE ---\n";
        cout << "1. Insert at Front\n";
        cout << "2. Insert at Rear\n";
        cout << "3. Delete Front\n";
        cout << "4. Display\n";
        cout << "5. Delete Rear\n";
        cout << "6. Get Size\n";
        cout << "7. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                insertFront();
                break;

            case 2:
                insertRear();
                break;

            case 3:
                deleteFront();
                break;

            case 4:
                display();
                break;

            case 5:
                deleteRear();
                break;

            case 6:
                getSize();
                break;

            case 7:
                cout << "Exiting program.\n";
                break;

            default:
                cout << "Invalid choice.\n";
        }

    } while (choice != 7);

    return 0;
}
