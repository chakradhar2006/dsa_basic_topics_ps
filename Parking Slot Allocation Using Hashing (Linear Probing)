#include <iostream>
using namespace std;

int main()
{
    int size;

    cout << "Enter hash table size: ";
    cin >> size;

    int hashTable[100];

    for (int i = 0; i < size; i++)
    {
        hashTable[i] = -1;
    }

    int n;

    cout << "Enter number of vehicles: ";
    cin >> n;

    cout << "Enter vehicle registration numbers:\n";

    for (int i = 0; i < n; i++)
    {
        int carNumber;
        cin >> carNumber;

        int index = carNumber % size;
        int start = index;

        while (hashTable[index] != -1)
        {
            index = (index + 1) % size;

            if (index == start)
            {
                cout << "Hash table is full\n";
                break;
            }
        }

        if (hashTable[index] == -1)
        {
            hashTable[index] = carNumber;
        }
    }

    cout << "\nParking Slot Allocation:\n";

    for (int i = 0; i < size; i++)
    {
        if (hashTable[i] == -1)
        {
            cout << "Slot " << i << ": Empty\n";
        }
        else
        {
            cout << "Slot " << i
                 << ": Vehicle " << hashTable[i] << endl;
        }
    }

    return 0;
}
